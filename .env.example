# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get this after creating a webhook endpoint (see README) or from `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build Stripe's success/cancel redirect URLs. In production, set
# this to your real domain (e.g. https://memebid.com)
APP_URL=http://localhost:3000

# Get these from your Supabase project: Settings → API
# ⚠️ SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It is only
# ever read on the server (API routes, server components) and must NEVER
# be prefixed with NEXT_PUBLIC_ or shipped to the browser.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
